<header class="top">
  <div class="wrap">
    <div class="mark">KV Dissolve<small>메인 키비주얼 전환 시안</small></div>
    <nav class="tabs" aria-label="시안 선택">{{TABS}}</nav>
  </div>
</header>

<section class="scrolly" id="scrolly" aria-label="스크롤 키비주얼">
  <div class="sticky" id="sticky">
    <nav class="rail" id="rail" aria-label="비주얼 위치"></nav>
    <div class="hint" id="hint" aria-hidden="true">SCROLL<svg viewBox="0 0 16 16"><path d="m3 6 5 5 5-5"/></svg></div>
  </div>
</section>

<section class="spec">
  <div class="wrap spec-grid">
    <div>
      <div class="tag">Variant {{ID}}</div>
      <h1>{{NAME_EN}}<span>{{NAME_KO}}</span></h1>
      <p class="lead">{{LEAD}}</p>
      <ol>{{STEPS}}</ol>
    </div>
    <div class="panel">
      <h3>인터랙션 스펙</h3>
      <table><tbody>{{SPEC_ROWS}}</tbody></table>
      <div class="tune">
        <label for="feather-range">마스크 경계 폭 <output id="feather-out">45%</output></label>
        <input type="range" id="feather-range" min="10" max="80" step="5" value="45">
        <label for="smooth-range">스크롤 관성 <output id="smooth-out">0.08</output></label>
        <input type="range" id="smooth-range" min="0.03" max="1" step="0.01" value="0.08">
        <div class="btns"><button type="button" class="btn" id="to-top">처음부터 다시 보기</button></div>
      </div>
      <p class="note">관성 값이 낮을수록 스크롤을 멈춘 뒤에도 화면이 더 길고 부드럽게 따라옵니다. 비주얼은 코드로 그린 플레이스홀더입니다.</p>
    </div>
  </div>
</section>

<script>
(function(){
"use strict";
var V={{VCONF}};
{{ART}}
var N=SLIDES.length,SEG=1.2;
var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
var $=function(id){return document.getElementById(id)};
var scrolly=$("scrolly"),sticky=$("sticky"),rail=$("rail"),hint=$("hint");
scrolly.style.height=(100+(N-1)*SEG*100)+"vh";
var L=[];
SLIDES.forEach(function(s,i){
  var el=document.createElement("div");el.className="layer";el.style.zIndex=i+1;el.style.color=s.ink;
  var cv=document.createElement("canvas");cv.setAttribute("aria-hidden","true");
  var sh=document.createElement("div");sh.className="shade";
  var big=document.createElement("div");big.className="big";big.textContent=s.word;big.setAttribute("aria-hidden","true");
  var cp=document.createElement("div");cp.className="copy";
  var cin=document.createElement("div");cin.style.cssText="display:flex;flex-direction:column;gap:14px";
  cin.innerHTML='<div class="eyebrow"></div><h2></h2><p class="sub"></p><div class="period"></div>';
  cin.children[0].textContent=s.eyebrow;s.t.forEach(function(t){var o=document.createElement("span");o.className="ln";o.textContent=t;cin.children[1].appendChild(o)});
  cin.children[2].textContent=s.sub;cin.children[3].textContent=s.period;
  cp.appendChild(cin);el.appendChild(cv);el.appendChild(big);el.appendChild(sh);el.appendChild(cp);sticky.insertBefore(el,rail);
  L.push({el:el,cv:cv,sh:sh,big:big,cin:cin});
  var b=document.createElement("button");b.type="button";b.setAttribute("aria-label",(i+1)+"번 비주얼로 이동");
  b.innerHTML="<i><b></b></i><span>"+(i<9?"0":"")+(i+1)+"</span>";
  b.onclick=function(){window.scrollTo({top:scrolly.offsetTop+i*SEG*innerHeight+1,behavior:"smooth"})};
  rail.appendChild(b);L[i].tick=b;
});
var H=1;
function layout(){var r=sticky.getBoundingClientRect(),d=Math.min(window.devicePixelRatio||1,2);H=r.height;
  L.forEach(function(l,i){drawArt(l.cv,Math.round(r.width*d),Math.round(r.height*1.08*d),SLIDES[i],i)});dirty=true}
var rt;window.addEventListener("resize",function(){clearTimeout(rt);rt=setTimeout(layout,120)});

var FEATHER=45,SMOOTH=reduce?1:0.08,cur=0,dirty=true;
function clamp(x){return x<0?0:x>1?1:x}
function ss(x){x=clamp(x);return x*x*(3-2*x)}
function target(){return Math.max(0,Math.min(N-1,(window.scrollY-scrolly.offsetTop)/(SEG*innerHeight)))}
function eIn(i,c){if(i<=0)return 1;if(i>=N)return 0;return ss((clamp(c-(i-1))-.12)/.76)}
function render(c){
  for(var i=0;i<N;i++){
    var l=L[i],ei=eIn(i,c),eo=i<N-1?eIn(i+1,c):0;
    if(ei<=0){l.el.style.visibility="hidden";continue}
    l.el.style.visibility="visible";
    if(ei>=1){l.el.style.webkitMaskImage=l.el.style.maskImage="none"}
    else{var a=ei*(100+FEATHER)-FEATHER,b=a+FEATHER;
      var m="linear-gradient(to top,#000 "+a.toFixed(2)+"%,transparent "+b.toFixed(2)+"%)";
      l.el.style.webkitMaskImage=m;l.el.style.maskImage=m}
    l.cv.style.transform="translate3d(0,"+(((1-ei)*.06-eo*.04)*H).toFixed(1)+"px,0)";
    l.big.style.transform="translate3d(0,"+(((1-ei)*.14-eo*.06)*H).toFixed(1)+"px,0)";
    l.sh.style.opacity=(eo*.4).toFixed(3);
    var op=clamp((ei-.45)/.4)*(1-clamp(eo/.45));
    l.cin.style.opacity=op.toFixed(3);
    l.cin.style.transform="translate3d(0,"+((1-clamp((ei-.45)/.55))*36-eo*28).toFixed(1)+"px,0)";
    l.tick.querySelector("b").style.transform=(innerWidth<=720?"scaleX(":"scaleY(")+(i===0?1:ei).toFixed(3)+")";
    l.tick.classList.toggle("on",ei>.5&&eo<.5);
  }
  hint.style.opacity=c<.04?1:0;
}
var last=performance.now();
(function loop(now){var dt=Math.min(64,now-last);last=now;var t=target();
  var k=1-Math.pow(1-SMOOTH,dt/16.67);
  if(Math.abs(t-cur)>.0004||dirty){cur+=(t-cur)*k;if(Math.abs(t-cur)<.0004)cur=t;render(cur);dirty=false}
  requestAnimationFrame(loop)})(last);
layout();render(0);

$("feather-range").oninput=function(){FEATHER=+this.value;$("feather-out").textContent=FEATHER+"%";dirty=true};
$("smooth-range").oninput=function(){SMOOTH=+this.value;$("smooth-out").textContent=SMOOTH.toFixed(2)};
$("to-top").onclick=function(){window.scrollTo({top:0,behavior:"smooth"})};
})();
</script>
