# 서버 포트 (Railway/Render는 자체 PORT를 주입하므로 배포 환경에서는 보통 생략)
PORT=3100

# /mcp 엔드포인트 Bearer 토큰 — Next.js 앱의 MCP_SERVER_AUTH_TOKEN과 동일한 값이어야 한다
MCP_SERVER_AUTH_TOKEN=

# Figma REST API (get_figma_context에서 사용, 읽기 전용 Personal Access Token)
FIGMA_ACCESS_TOKEN=

# Google Sheets 서비스 계정 (get_company_policies에서 사용, 읽기 전용 범위만 사용)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Supabase (get_change_impact에서 trace_links 등을 읽기 전용으로 조회)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
